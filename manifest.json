{
  "schemaVersion": 1,
  "id": "hotwheels.notification-controls",
  "name": "Notification Controls",
  "version": "1.4.0",
  "author": "swheel33",
  "license": "MIT",
  "description": "Per-application notification settings for Omarchy",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "service": "NotificationService.qml",
    "panel": "Panel.qml",
    "barWidget": "Bell.qml"
  },
  "barWidget": {
    "displayName": "Notifications",
    "description": "Notification settings and Do Not Disturb",
    "category": "System",
    "defaultSection": "right",
    "allowMultiple": false
  },
  "omarchy": {
    "clonedFrom": "omarchy.notifications"
  }
}
